{
  "info": {
    "_postman_id": "saraha-api",
    "name": "Saraha API",
    "description": "Requests for the Saraha server API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9090"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "googleIdToken",
      "value": ""
    },
    {
      "key": "receiverId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\",\n  \"confirmPassword\": \"Password@123\",\n  \"DOB\": \"1990-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/authentication/signup",
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "signup"]
            }
          }
        },
        {
          "name": "Sign up with Google",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.collectionVariables.set('token', response.accessToken);",
                  "}",
                  "if (response.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', response.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/authentication/google-signUp",
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "google-signUp"]
            }
          }
        },
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.accessToken) {",
                  "    pm.collectionVariables.set('token', response.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/authentication/login",
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "login"]
            }
          }
        },
        {
          "name": "Test authenticated request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/authentication/test",
              "host": ["{{baseUrl}}"],
              "path": ["authentication", "test"]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send message",
          "description": "Authentication is optional. Set the optional Authorization header to send this message as the logged-in user. Provide content, up to two image attachments, or both. Each image must be JPEG or PNG and no larger than 10 MB.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data?.message?._id) {",
                  "    pm.collectionVariables.set('messageId', response.data.message._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "Accept-Language",
                "value": "EN"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "content",
                  "value": "Hello, this is a message.",
                  "type": "text"
                },
                {
                  "key": "attachments",
                  "type": "file",
                  "src": "",
                  "disabled": true
                },
                {
                  "key": "attachments",
                  "type": "file",
                  "src": "",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/message/{{receiverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["message", "{{receiverId}}"]
            }
          }
        },
        {
          "name": "List my messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "EN"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/message/list",
              "host": ["{{baseUrl}}"],
              "path": ["message", "list"]
            }
          }
        },
        {
          "name": "Get message",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "EN"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/message/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["message", "{{messageId}}"]
            }
          }
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept-Language",
                "value": "EN"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/message/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["message", "{{messageId}}"]
            }
          }
        }
      ]
    }
  ]
}
